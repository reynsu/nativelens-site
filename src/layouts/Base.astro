---
// Base layout — common <head>, meta, and global styles.
//
// All meaningful content lives in the page; this layout just owns the
// HTML scaffold so SEO + OG tags stay consistent across any future pages.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'nativelens — E2E testing for React Native',
  description = 'Captures the React component tree (props, state, hooks) at every action, not just screenshots. AI-diagnosed test failures, local-first.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://nativelens.dev').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme: read user preference BEFORE first paint so we don't flash. -->
    <meta name="theme-color" content="#f0ece1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Inline + sync = runs before any CSS-driven paint. Reads localStorage
      // first, falls back to prefers-color-scheme. Sets data-theme on <html>
      // so the variable block in global.css picks the right palette before
      // body renders.
      (function () {
        try {
          const stored = localStorage.getItem('nativelens-theme');
          const theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          /* localStorage unavailable — falls through to default light */
        }
      })();
    </script>

    <!-- Font preconnect: IBM Plex Mono via Google Fonts CDN. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />

    <script is:inline>
      // Theme toggle wiring + intersection-driven section reveal.
      // No framework, no bundler magic — under 30 lines, fires once on
      // DOMContentLoaded.
      document.addEventListener('DOMContentLoaded', function () {
        // ---- Theme toggle ----
        var html = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) {
          var sync = function () {
            var current = html.getAttribute('data-theme') || 'light';
            btn.textContent = current === 'dark' ? '[ light ]' : '[ dark ]';
            btn.setAttribute('aria-pressed', current === 'dark' ? 'true' : 'false');
          };
          sync();
          btn.addEventListener('click', function () {
            var next = (html.getAttribute('data-theme') || 'light') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            try {
              localStorage.setItem('nativelens-theme', next);
            } catch (_) {}
            // Also flip the theme-color meta so iOS Safari chrome matches.
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', next === 'dark' ? '#0c0c0c' : '#f0ece1');
            sync();
          });
        }

        // ---- Reveal sections on enter ----
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.setAttribute('data-anim', 'in');
                  io.unobserve(e.target);
                }
              });
            },
            { threshold: 0.15 },
          );
          document.querySelectorAll('.sec').forEach(function (el) {
            io.observe(el);
          });
        } else {
          document.querySelectorAll('.sec').forEach(function (el) {
            el.setAttribute('data-anim', 'in');
          });
        }
      });
    </script>
  </body>
</html>
